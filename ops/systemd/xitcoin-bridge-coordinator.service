[Unit]
Description=Xitcoin bridge coordinator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xitcoin-bridge-coordinator
Group=xitcoin-bridge-coordinator
UMask=0077
WorkingDirectory=/opt/xitcoin-bridge-relayer/current
ExecStart=/opt/xitcoin-bridge-node/24.19.0/bin/node --jitless /opt/xitcoin-bridge-relayer/current/src/coordinator-cli.js /etc/xitcoin-bridge/coordinator.json
LoadCredentialEncrypted=signer-1-transport-token:/etc/credstore.encrypted/xitcoin-bridge-coordinator-signer-1-transport-token
LoadCredentialEncrypted=signer-2-transport-token:/etc/credstore.encrypted/xitcoin-bridge-coordinator-signer-2-transport-token
LoadCredentialEncrypted=signer-3-transport-token:/etc/credstore.encrypted/xitcoin-bridge-coordinator-signer-3-transport-token
Restart=on-failure
RestartSec=5s
StateDirectory=xitcoin-bridge/coordinator
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/var/lib/xitcoin-bridge/coordinator

[Install]
WantedBy=multi-user.target
