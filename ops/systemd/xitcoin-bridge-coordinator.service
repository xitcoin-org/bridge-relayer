[Unit]
Description=Xitcoin bridge coordinator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xitcoin-bridge-coordinator
Group=xitcoin-bridge-coordinator
UMask=0077
WorkingDirectory=/opt/xitcoin-bridge-relayer/current
ExecStart=/usr/bin/env node /opt/xitcoin-bridge-runtime/coordinator.mjs
Restart=on-failure
RestartSec=5s
StateDirectory=xitcoin-bridge/coordinator
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
