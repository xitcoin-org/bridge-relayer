[Unit]
Description=Xitcoin bridge signer %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xitcoin-bridge-signer-%i
Group=xitcoin-bridge-signer-%i
UMask=0077
WorkingDirectory=/opt/xitcoin-bridge-relayer/current
ExecStart=/opt/xitcoin-bridge-node/24.19.0/bin/node /opt/xitcoin-bridge-relayer/current/src/signer-cli.js /etc/xitcoin-bridge/signer-%i.json
LoadCredentialEncrypted=keystore-password:/etc/credstore.encrypted/xitcoin-bridge-signer-%i-keystore-password
LoadCredentialEncrypted=transport-token:/etc/credstore.encrypted/xitcoin-bridge-signer-%i-transport-token
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
