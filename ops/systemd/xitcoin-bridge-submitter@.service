[Unit]
Description=Xitcoin bridge destination submitter %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xitcoin-bridge-submitter-%i
Group=xitcoin-bridge-submitter-%i
UMask=0077
LimitCORE=0
IPAddressDeny=any
WorkingDirectory=/opt/xitcoin-bridge-relayer/current
ExecStart=/opt/xitcoin-bridge-node/24.19.0/bin/node --jitless /opt/xitcoin-bridge-relayer/current/src/submitter-cli.js start %i /etc/xitcoin-bridge/submitter-%i.json
Restart=no
RestartSec=5s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
